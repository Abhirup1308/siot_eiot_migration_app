# Copy to .env and obtain the values from the SAP tenant/service owner.
# Never commit real credentials. Use the canonical variable names below.
# Base URLs must stop before the API paths documented in docs/HANDOVER.md.

# SIoT Cold Store: all four fields below are required.
SIOT_COLD_STORE_CLIENT_ID=
SIOT_COLD_STORE_CLIENT_SECRET=
SIOT_COLD_STORE_TOKEN_URL=
SIOT_COLD_STORE_BASE_URL=
# Optional: blank uses SIOT_COLD_STORE_BASE_URL.
SIOT_COLD_STORE_DOWNLOAD_BASE_URL=
# form or basic, as required by the token endpoint.
SIOT_COLD_STORE_AUTH_STYLE=form

# SIoT source metadata: supply all five values for the intended tenant.
SIOT_INDICATOR_CLIENT_ID=
SIOT_INDICATOR_CLIENT_SECRET=
SIOT_INDICATOR_TOKEN_URL=
SIOT_INDICATOR_API_KEY=
SIOT_APM_BASE_URL=
SIOT_INDICATOR_AUTH_STYLE=form

# EIoT target metadata and ingestion: supply all five values.
EIOT_CLIENT_ID=
EIOT_CLIENT_SECRET=
EIOT_TOKEN_URL=
EIOT_API_KEY=
EIOT_APM_BASE_URL=
EIOT_AUTH_STYLE=form

# Optional overrides. Commented values show defaults from src/config.py.
# REQUEST_TIMEOUT_SECONDS=60
# EXPORT_SLICE_DAYS=31
# EXPORT_MIN_SLICE_DAYS=1
# TRANSFORM_CHUNK_ROWS=150000
# UPLOAD_MAX_ROWS=250000
# UPLOAD_MAX_MB=30
# AUTO_POLL_SECONDS=10
# AUTO_DOWNLOAD_READY=true
# DOWNLOAD_CHUNK_MB=8
# DISCOVERY_WORKERS=12
# EXPORT_WORKERS=8
# STATUS_WORKERS=16
# DOWNLOAD_WORKERS=4
# GZIP_WORKERS=4
# MAPPING_WORKERS=12
# TRANSFORM_WORKERS=4
# PREPARE_WORKERS=3
# UPLOAD_WORKERS=4
# TRANSFORM_PARQUET_COMPRESSION=snappy
# UPLOAD_PARQUET_COMPRESSION=gzip
# LARGE_SCOPE_TO_COUNT=100
# LARGE_SCOPE_DAYS=31
# LARGE_SCOPE_JOBS=100
# MIGRATION_DATA_DIR=data
# MIGRATION_DB_PATH=data/migration.sqlite3
